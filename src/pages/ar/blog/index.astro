---
import Layout from '../../../layouts/Layout.astro';
import strings from '../../../i18n/strings.json';

const s = strings.ar.ar_stub;
---

<Layout locale="ar" title="المدونة — Zenith Digital MENA" description="مقالات حول العمل الرقمي في منطقة الخليج — الصناعة والحرفة والفجوة بين ما يُبنى وما ينبغي أن يكون.">
  <section class="mx-auto max-w-2xl px-6 py-20 text-center">
    <h1 class="text-3xl font-semibold tracking-tight">{s.notice}</h1>
    <p class="mt-4 text-white/70">{s.subhead}</p>
    <a
      href="/blog"
      class="mt-8 inline-block rounded-full bg-white text-black px-5 py-2.5 text-sm font-medium hover:bg-white/90"
    >{s.cta}</a>
  </section>
</Layout>
